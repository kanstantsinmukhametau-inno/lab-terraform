#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.lab.internal
manage_etc_hosts: true
timezone: UTC

users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false
disable_root: true

package_update: true
packages:
  - qemu-guest-agent
  - python3

runcmd:
  - systemctl enable --now qemu-guest-agent

final_message: "${hostname} ready after $UPTIME seconds"
